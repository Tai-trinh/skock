@startuml
class ShipSurvivor <<sealed>> {
    + BlueprintDrawingId : string <<get>> <<init>> = ""
    + Hp : float <<get>> <<init>>
    + IsMothership : bool <<get>> <<init>>
    + FleetIndex : int? <<get>> <<init>>
}
class KilledShip <<sealed>> {
    + HullClass : string <<get>> <<init>> = ""
    + IsMothership : bool <<get>> <<init>>
}
class BattleResult <<sealed>> {
    + Winner : string <<get>> <<init>> = ""
    + Ticks : uint <<get>> <<init>>
    + Reason : string <<get>> <<init>> = ""
    + FleetASurvivors : IReadOnlyList<ShipSurvivor> <<get>> <<init>>
    + FleetBSurvivors : IReadOnlyList<ShipSurvivor> <<get>> <<init>>
    + FleetAKilled : IReadOnlyList<KilledShip> <<get>> <<init>>
    + FleetBKilled : IReadOnlyList<KilledShip> <<get>> <<init>>
    + FleetADamageDealt : float <<get>> <<init>>
    + FleetBDamageDealt : float <<get>> <<init>>
}
class SimRunException <<sealed>> {
}
Exception <|-- SimRunException
@enduml
