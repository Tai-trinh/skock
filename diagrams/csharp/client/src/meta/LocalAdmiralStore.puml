@startuml
class LocalAdmiralStore <<sealed>> {
    + LocalAdmiralStore(dataDir:string)
    + Load() : Task
    + GetAdmirals() : IReadOnlyList<Admiral>
    + GetFactions() : IReadOnlyList<Faction>
    + FindAdmiral(id:string) : Admiral?
    + FindFaction(id:string) : Faction?
    + NameFor(admiralId:string) : string
}
class AdmiralDto <<sealed>> {
    + Id : string <<get>> <<set>> = ""
    + Name : string <<get>> <<set>> = ""
    + FactionId : string <<get>> <<set>> = ""
    + BonusText : string <<get>> <<set>> = ""
    + StartingSalvage : int <<get>> <<set>>
    + StartingTech : int <<get>> <<set>>
    + StartingHangarCapacity : int <<get>> <<set>>
    + StartingFleet : FleetJsonData <<get>> <<set>>
}
IAdmiralStore <|-- LocalAdmiralStore
LocalAdmiralStore +-- AdmiralDto
@enduml
