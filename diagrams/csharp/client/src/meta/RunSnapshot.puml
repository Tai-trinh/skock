@startuml
class RunSnapshot <<sealed>> {
    + PlayerId : string? <<get>> <<set>>
    + RunSeed : ulong <<get>> <<set>>
    + Salvage : int <<get>> <<set>>
    + Tech : int <<get>> <<set>>
    + HangarCapacity : int <<get>> <<set>>
    + JumpNumber : int <<get>> <<set>>
    + LossCount : int <<get>> <<set>>
    + AdmiralId : string <<get>> <<set>> = ""
    + TierRerolls : int[]? <<get>> <<set>>
    + ResearchRerolls : int[]? <<get>> <<set>>
    + UpgradePurchases : Dictionary<string, int>? <<get>> <<set>>
    + IsComplete : bool <<get>> <<set>>
    + JumpHistory : List<JumpRecord>? <<get>> <<set>>
    + Fleet : FleetJsonData <<get>> <<set>>
}
@enduml
