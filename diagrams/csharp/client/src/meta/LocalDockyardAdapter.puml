@startuml
class LocalDockyardAdapter <<sealed>> {
    - {static} <<readonly>> JsonOpts : JsonSerializerOptions
    - <<readonly>> _process : Process
    - <<readonly>> _stdin : StreamWriter
    - <<readonly>> _stdout : StreamReader
    - _disposed : bool
    + LocalDockyardAdapter(binaryPath:string)
    + <<async>> GetOffersAsync(input:DockSessionInput) : Task<DockOffersResult>
    + <<async>> CommissionAsync(blueprintId:string) : Task<DockCommissionResult>
    + <<async>> SalvageFleetShipAsync(index:int) : Task<DockSalvageResult>
    + <<async>> RerollTierAsync(tierIndex:int) : Task<DockTierResult>
    + <<async>> RerollResearchAsync(trackIndex:int) : Task<DockTrackResult>
    + <<async>> BuyResearchAsync(upgradeId:string) : Task<DockActionResult>
    + <<async>> ShoppingDoneAsync() : Task<DockSessionDelta>
    + <<async>> DisposeAsync() : ValueTask
    - <<async>> SendReceiveAsync(message:object) : Task<string>
    - {static} Deserialize(json:string) : T
}
class GetOffersEnvelope <<sealed>> {
    + Action : string <<get>>
    + PlayerId : string <<get>>
    + RunSeed : ulong <<get>>
    + JumpNumber : int <<get>>
    + TierRerolls : int[] <<get>>
    + ResearchRerolls : int[] <<get>>
    + Salvage : int <<get>>
    + Tech : int <<get>>
    + HangarUsed : int <<get>>
    + HangarCap : int <<get>>
    + Fleet : System.Collections.Generic.List<FleetShipRef> <<get>>
    + UpgradePurchases : System.Collections.Generic.Dictionary<string, int> <<get>>
    + GetOffersEnvelope(input:DockSessionInput)
}
IDockyard <|-- LocalDockyardAdapter
LocalDockyardAdapter +-- GetOffersEnvelope
@enduml
