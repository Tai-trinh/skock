@startuml
class LocalStatsStore <<sealed>> {
    + RecordBattle(record:JumpRecord, inputs:BattleInputs) : Task
    + RecordSalvageSpent(amount:int) : void
    + RecordTechSpent(amount:int) : void
    + RecordCapitalShipBought() : void
    + RecordRunVictory() : void
    + GetJumpHistory() : IReadOnlyList<JumpRecord>
    + GetLifetimeStats() : LifetimeStats
    + Reset() : void
    + LoadHistory(records:IReadOnlyList<JumpRecord>) : void
}
IStatsStore <|-- LocalStatsStore
@enduml
