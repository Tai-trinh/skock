@startuml
class UserSettings <<sealed>> {
    + MasterVolume : float <<get>> <<set>> = 1.0f
    + MusicVolume : float <<get>> <<set>> = 1.0f
    + SfxVolume : float <<get>> <<set>> = 1.0f
    + Fullscreen : bool <<get>> <<set>> = false
    + Apply() : void
    + Save(path:string) : void
    + {static} Load(path:string) : UserSettings
}
@enduml
