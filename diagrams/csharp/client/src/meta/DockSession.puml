@startuml
class DockSessionInput <<sealed>> {
    + PlayerId : string <<get>> <<init>> = ""
    + RunSeed : ulong <<get>> <<init>>
    + JumpNumber : int <<get>> <<init>>
    + TierRerolls : int[] <<get>> <<init>>
    + ResearchRerolls : int[] <<get>> <<init>>
    + Salvage : int <<get>> <<init>>
    + Tech : int <<get>> <<init>>
    + HangarUsed : int <<get>> <<init>>
    + HangarCap : int <<get>> <<init>>
    + Fleet : List<FleetShipRef> <<get>> <<init>>
    + UpgradePurchases : Dictionary<string, int> <<get>> <<init>>
}
class FleetShipRef <<sealed>> {
    + Index : int <<get>> <<init>>
    + Tonnage : int <<get>> <<init>>
    + BlueprintId : string? <<get>> <<init>>
}
class DockOffersResult <<sealed>> {
    + ShipTiers : List<ShipTierOffer> <<get>> <<init>>
    + ResearchTracks : List<ResearchTrackOffer> <<get>> <<init>>
    + State : DockResourceState <<get>> <<init>>
}
class ShipTierOffer <<sealed>> {
    + TierIndex : int <<get>> <<init>>
    + Label : string <<get>> <<init>> = ""
    + RerollCost : int <<get>> <<init>>
    + Slots : List<ShipSlotOffer> <<get>> <<init>>
}
class ShipSlotOffer <<sealed>> {
    + BlueprintId : string <<get>> <<init>> = ""
    + DisplayName : string <<get>> <<init>> = ""
    + SalvageCost : int <<get>> <<init>>
    + Tonnage : int <<get>> <<init>>
    + ShipDef : ShipDefData <<get>> <<init>>
}
class ResearchTrackOffer <<sealed>> {
    + TrackIndex : int <<get>> <<init>>
    + Label : string <<get>> <<init>> = ""
    + RerollCost : int? <<get>> <<init>>
    + Items : List<ResearchItemOffer> <<get>> <<init>>
}
class ResearchItemOffer <<sealed>> {
    + UpgradeId : string <<get>> <<init>> = ""
    + DisplayName : string <<get>> <<init>> = ""
    + Description : string <<get>> <<init>> = ""
    + TechCost : int <<get>> <<init>>
    + MaxPurchases : int <<get>> <<init>>
    + Purchased : int <<get>> <<init>>
    + Effects : List<UpgradeEffect> <<get>> <<init>>
}
class DockResourceState <<sealed>> {
    + Salvage : int <<get>> <<init>>
    + Tech : int <<get>> <<init>>
    + HangarUsed : int <<get>> <<init>>
    + HangarCap : int <<get>> <<init>>
}
class DockActionResult <<sealed>> {
    + Ok : bool <<get>> <<init>>
    + Error : string? <<get>> <<init>>
    + State : DockResourceState? <<get>> <<init>>
}
class DockCommissionResult <<sealed>> {
    + Ok : bool <<get>> <<init>>
    + Error : string? <<get>> <<init>>
    + Ship : ShipSlotOffer? <<get>> <<init>>
    + State : DockResourceState? <<get>> <<init>>
}
class DockSalvageResult <<sealed>> {
    + Ok : bool <<get>> <<init>>
    + Error : string? <<get>> <<init>>
    + SalvageYield : int <<get>> <<init>>
    + State : DockResourceState? <<get>> <<init>>
}
class DockTierResult <<sealed>> {
    + Ok : bool <<get>> <<init>>
    + Error : string? <<get>> <<init>>
    + Tier : ShipTierOffer? <<get>> <<init>>
    + State : DockResourceState? <<get>> <<init>>
}
class DockTrackResult <<sealed>> {
    + Ok : bool <<get>> <<init>>
    + Error : string? <<get>> <<init>>
    + Track : ResearchTrackOffer? <<get>> <<init>>
    + State : DockResourceState? <<get>> <<init>>
}
class SessionShip <<sealed>> <<record>> {
    + CurrentIndex : int <<get>> <<init>>
    + Name : string <<get>> <<init>>
    + Tonnage : int <<get>> <<init>>
}
class DockSessionDelta <<sealed>> {
    + Ok : bool <<get>> <<init>>
    + Error : string? <<get>> <<init>>
    + Delta : DockDelta? <<get>> <<init>>
}
class DockDelta <<sealed>> {
    + SalvageFinal : int <<get>> <<init>>
    + TechFinal : int <<get>> <<init>>
    + HangarUsedFinal : int <<get>> <<init>>
    + HangarCapFinal : int <<get>> <<init>>
    + TierRerollsFinal : int[] <<get>> <<init>>
    + ResearchRerollsFinal : int[] <<get>> <<init>>
    + ShipsCommissioned : List<string> <<get>> <<init>>
    + ShipsSalvaged : List<int> <<get>> <<init>>
    + UpgradesPurchased : List<ResearchItemOffer> <<get>> <<init>>
}
abstract class UpgradeEffect {
}
class HangarCapEffect <<sealed>> {
    + Delta : int <<get>> <<init>>
}
class MothershipHpEffect <<sealed>> {
    + Delta : double <<get>> <<init>>
}
class MothershipWeaponDamageEffect <<sealed>> {
    + Delta : double <<get>> <<init>>
}
class MothershipWeaponRangeEffect <<sealed>> {
    + Delta : double <<get>> <<init>>
}
class FleetHpEffect <<sealed>> {
    + Delta : double <<get>> <<init>>
}
class FleetSpeedEffect <<sealed>> {
    + Delta : double <<get>> <<init>>
}
class FleetWeaponDamageEffect <<sealed>> {
    + Delta : double <<get>> <<init>>
}
class FleetWeaponRangeEffect <<sealed>> {
    + Delta : double <<get>> <<init>>
}
class FleetWeaponCooldownEffect <<sealed>> {
    + Delta : int <<get>> <<init>>
    + Min : int <<get>> <<init>>
}
class FleetArmorEffect <<sealed>> {
    + Delta : double <<get>> <<init>>
    + Max : double <<get>> <<init>>
}
class SalvageEffect <<sealed>> {
    + Delta : int <<get>> <<init>>
}
UpgradeEffect <|-- HangarCapEffect
UpgradeEffect <|-- MothershipHpEffect
UpgradeEffect <|-- MothershipWeaponDamageEffect
UpgradeEffect <|-- MothershipWeaponRangeEffect
UpgradeEffect <|-- FleetHpEffect
UpgradeEffect <|-- FleetSpeedEffect
UpgradeEffect <|-- FleetWeaponDamageEffect
UpgradeEffect <|-- FleetWeaponRangeEffect
UpgradeEffect <|-- FleetWeaponCooldownEffect
UpgradeEffect <|-- FleetArmorEffect
UpgradeEffect <|-- SalvageEffect
@enduml
