#!/usr/bin/env bash
# Formats staged Rust and C# files, then re-stages them.
# Partial staging (git add -p) is a known caveat: formatter re-stages the whole file.
set -e

CARGO=$(command -v cargo.exe &>/dev/null && echo cargo.exe || echo cargo)
CSHARPIER=$(command -v csharpier.exe &>/dev/null && echo csharpier.exe || echo csharpier)

STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
STAGED_CS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.cs$' || true)
STAGED_CARGO_TOML=$(git diff --cached --name-only --diff-filter=ACM | grep 'Cargo\.toml' || true)

if [ -n "$STAGED_RS" ]; then
    $CARGO fmt
    # shellcheck disable=SC2086
    git add $STAGED_RS
fi

if [ -n "$STAGED_RS" ] || [ -n "$STAGED_CARGO_TOML" ]; then
    bash "$(git rev-parse --show-toplevel)/scripts/gen-rust-diagram.sh"
fi

if [ -n "$STAGED_CS" ]; then
    $CSHARPIER format client/
    # shellcheck disable=SC2086
    git add $STAGED_CS
    bash "$(git rev-parse --show-toplevel)/scripts/gen-csharp-diagram.sh"
fi
