{
  "1": {
    "inputs": {"ckpt_name": "__MODEL__"},
    "class_type": "CheckpointLoaderSimple"
  },
  "2": {
    "inputs": {"text": "__PROMPT__", "clip": ["1", 1]},
    "class_type": "CLIPTextEncode"
  },
  "3": {
    "inputs": {"text": "__NEGATIVE__", "clip": ["1", 1]},
    "class_type": "CLIPTextEncode"
  },
  "4": {
    "inputs": {"width": "__WIDTH__", "height": "__HEIGHT__", "batch_size": 1},
    "class_type": "EmptyLatentImage"
  },
  "5": {
    "inputs": {"ipadapter_file": "ip-adapter_sdxl_vit-h.safetensors"},
    "class_type": "IPAdapterModelLoader"
  },
  "6": {
    "inputs": {"clip_name": "clip_vision_h14.safetensors"},
    "class_type": "CLIPVisionLoader"
  },
  "7": {
    "inputs": {"image": "__STYLE_IMAGE__", "upload": "image"},
    "class_type": "LoadImage"
  },
  "8": {
    "inputs": {
      "weight": "__IPADAPTER_STRENGTH__",
      "start_at": 0.0,
      "end_at": 1.0,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "embeds_scaling": "V only",
      "model": ["1", 0],
      "ipadapter": ["5", 0],
      "image": ["7", 0],
      "clip_vision": ["6", 0]
    },
    "class_type": "IPAdapterAdvanced"
  },
  "9": {
    "inputs": {"control_net_name": "controlnet-canny-sdxl.safetensors"},
    "class_type": "ControlNetLoader"
  },
  "10": {
    "inputs": {"image": "__SHAPE_IMAGE__", "upload": "image"},
    "class_type": "LoadImage"
  },
  "11": {
    "inputs": {"low_threshold": 100, "high_threshold": 200, "image": ["10", 0]},
    "class_type": "CannyEdgePreprocessor"
  },
  "12": {
    "inputs": {
      "strength": "__CONTROLNET_STRENGTH__",
      "start_percent": 0.0,
      "end_percent": 1.0,
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["9", 0],
      "image": ["11", 0]
    },
    "class_type": "ControlNetApplyAdvanced"
  },
  "13": {
    "inputs": {
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["8", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["4", 0]
    },
    "class_type": "KSampler"
  },
  "14": {
    "inputs": {"samples": ["13", 0], "vae": ["1", 2]},
    "class_type": "VAEDecode"
  },
  "15": {
    "inputs": {"filename_prefix": "__OUTPUT_PREFIX__", "images": ["14", 0]},
    "class_type": "SaveImage"
  }
}
